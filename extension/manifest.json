{
  "manifest_version": 3,
  "name": "Blooket Cyber Assistant",
  "version": "2.0.0",
  "description": "Learn Cyber Hack answers from visible feedback. Highlight known answers, select outputs, use answer keys, and press O to stop.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://cyber.blooket.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Blooket Cyber Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cyber.blooket.com/*"
      ],
      "js": [
        "controller.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
